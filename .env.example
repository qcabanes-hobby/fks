# ──────────────────────────────────────────────────────────────────────────────
# Fake Kebab Signal — environment template
# Copy to `.env` and fill in every value. `.env` is gitignored.
# ──────────────────────────────────────────────────────────────────────────────

# Public domain Caddy will serve and request a Let's Encrypt cert for.
# IMPORTANT: this domain MUST have a DNS A record pointing at the VPS public
# IP, AND ports 80 + 443 must be reachable from the public internet, BEFORE
# you run `docker compose up`. Caddy uses the ACME HTTP-01 challenge on
# port 80 to issue the cert; if DNS or port 80 isn't ready, issuance fails.
FKS_DOMAIN=fks.example.com

# Used as the `mailto:` subject of every VAPID-signed push request and as
# the ACME contact e-mail Let's Encrypt notifies if a cert is about to expire.
ADMIN_EMAIL=you@example.com

# Postgres password for the internal `db` service. Used by both `db` (to
# initialise the role) and `api` (in DATABASE_URL). Pick something long
# and random — the DB is not published, but treat it as a real secret.
POSTGRES_PASSWORD=change-me-to-a-long-random-string

# VAPID keypair for Web Push. Generate ONCE with:
#   docker run --rm node:20-alpine npx -y web-push generate-vapid-keys
# or, if you have node locally:
#   npx web-push generate-vapid-keys
# Paste the "Public Key" and "Private Key" outputs below. The public key
# is also served to the frontend via /api/push/vapid-public-key.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Subject the push service sees on outgoing VAPID-signed requests. Should
# match ADMIN_EMAIL. Some push providers reject requests without it.
VAPID_SUBJECT=mailto:you@example.com
