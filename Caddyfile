{$FKS_DOMAIN} {
    encode zstd gzip
    root * /srv/fks

    @api path /api/*
    handle @api {
        reverse_proxy api:3000
    }

    @sse path /sse/*
    handle @sse {
        reverse_proxy api:3000 {
            # flush_interval -1 disables response buffering so SSE events
            # reach the client immediately instead of being chunked.
            flush_interval -1
            transport http {
                read_timeout 24h
            }
        }
    }

    handle {
        try_files {path} /index.html
        file_server
    }

    @manifest path /manifest.webmanifest
    header @manifest Content-Type "application/manifest+json"

    @sw path /sw.js
    header @sw Cache-Control "no-cache, no-store, must-revalidate"

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
    }
}
